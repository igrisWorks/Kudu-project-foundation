{
  "name": "kuduns-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KuduNS Local SQLite desktop and secure server client",
  "desktopName": "KuduNS",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": "10.26.1"
  },
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "check:appimage": "bash check-appimage-runtime.sh ../release/desktop/KuduNS-0.1.0.AppImage",
    "package:deb": "electron-builder --config electron-builder.json --linux deb --x64",
    "package:appimage": "electron-builder --config electron-builder.json --linux AppImage --x64",
    "package:linux": "electron-builder --config electron-builder.json --linux deb AppImage --x64",
    "package:win": "electron-builder --config electron-builder.json --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
