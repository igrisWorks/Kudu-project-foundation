{
  "appId": "com.kuduns.desktop",
  "productName": "KuduNS",
  "asar": true,
  "directories": {
    "output": "../release/desktop"
  },
  "files": [
    "main.cjs",
    "preload.cjs",
    "connection-policy.cjs",
    "local-runtime.cjs",
    "local-preload.cjs",
    "package.json"
  ],
  "extraResources": [
    { "from": "local-backend", "to": "local-backend" },
    {
      "from": "../frontend/dist-desktop",
      "to": "renderer",
      "filter": [
        "desktop.html",
        "assets/**",
        "kuduns-wordmark.svg",
        "kuduns-mark.svg",
        "kuduns-favicon.svg"
      ]
    }
  ],
  "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
  "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true },
  "linux": {
    "category": "Utility",
    "executableArgs": [],
    "syncDesktopName": true,
    "target": [
      { "target": "deb", "arch": ["x64"] },
      { "target": "AppImage", "arch": ["x64"] }
    ]
  }
}
