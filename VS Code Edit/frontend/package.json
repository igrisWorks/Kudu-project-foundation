{
  "name": "@kudu/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:desktop": "tsc --noEmit -p tsconfig.json && vite build --mode desktop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test src/pages/SettingsPage.test.tsx"
  },
  "dependencies": {
    "@kudu/shared": "workspace:*",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "wouter": "3.3.5"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "25.3.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "30.1.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
