{
  "name": "@kudu/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../.env dist/index.js",
    "migrate": "node --env-file-if-exists=../.env dist/migrate.js",
    "auth:hash-password": "node --import tsx src/auth-cli.ts",
    "test": "node --import tsx --test src/app.test.ts src/config.test.ts src/registry-validation.test.ts src/registry.integration.test.ts"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@kudu/shared": "workspace:*",
    "fastify": "5.12.7",
    "kysely": "0.29.7",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "25.3.3",
    "@types/pg": "8.15.5",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
