# Local development (outside Docker)
DATABASE_URL=postgresql://kudu:kudu-local-only@localhost:5432/kudu
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
KUDU_IMPORT_DIRECTORY=./imports
KUDU_IMPORT_HOST_DIRECTORY=./imports

# Docker Compose database settings. Replace the example password before deployment.
POSTGRES_DB=kudu
POSTGRES_USER=kudu
POSTGRES_PASSWORD=replace-this-before-deployment
