# Local development (outside Docker)
DATABASE_URL=postgresql://kudu:kudu-local-only@localhost:5432/kudu
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
KUDU_IMPORT_DIRECTORY=./imports
KUDU_IMPORT_HOST_DIRECTORY=./imports
# Exact comma-separated REST hosts trusted to resolve to private RFC1918/ULA addresses.
KUDU_REST_TRUSTED_HOSTS=
# Optional REST bearer credentials belong in a separate, untracked .env.sources file.

# Authentication is required for registry and event API access.
# Generate this hash with `pnpm --filter @kudu/backend auth:hash-password`.
# The scrypt value contains `$`; quote it with single quotes in .env.
KUDU_AUTH_PASSWORD_HASH=
# Set SESSION_SECRET in the Replit Secrets panel or your protected host environment.
SESSION_SECRET=
# Keep true when served over HTTPS; only set false for isolated loopback HTTP.
KUDU_COOKIE_SECURE=true

# Docker Compose database settings. This password is local-only; replace it before deployment.
# Keep this image tag aligned with the release version in package.json.
KUDU_VERSION=0.1.0
POSTGRES_DB=kudu
POSTGRES_USER=kudu
POSTGRES_PASSWORD=kudu-local-only
